# =============================================================================
# WITCHR SANCTUM ENVIRONMENT CONFIGURATION (.env.example)
# Copy this template to .env.local and enter your actual project credentials.
# Never commit .env.local or share privileged secret keys in chat or git.
# =============================================================================

# --- AI Model Providers (Oracle Inquest & Synthesis) ---
ORACLE_AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- Supabase Project & Authentication ---
# Public project URL (Client and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Publishable Key (Client-safe browser key)
# Supabase publishable key (starts with sb_publishable_... or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Secret Key (STRICTLY SERVER-SIDE - Never expose to client bundles or browser)
# Supabase secret key (starts with sb_secret_... or legacy service_role secret key)
SUPABASE_SECRET_KEY=your-supabase-secret-key

